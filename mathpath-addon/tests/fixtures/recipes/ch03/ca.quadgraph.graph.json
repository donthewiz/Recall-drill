{
 "format": "mathpath-recipe/2",
 "version": 1,
 "course": "College Algebra",
 "section": {
  "book": "Bittinger, Beecher, Ellenbogen & Penna, College Algebra: Graphs and Models, 7e",
  "number": "3.3",
  "title": "Analyzing Graphs of Quadratic Functions"
 },
 "id": "ca.quadgraph.graph",
 "title": "Graph a quadratic function (MyMathLab tool: vertex, then one more point)",
 "sources": [
  "Bittinger 7e §3.3 Examples 1-3 (Video Notebook pp. 82-84)",
  "Test Form A #29e type (numbers differ)",
  "MyMathLab graph tool as Don described it: pick the shape, click the vertex, then a point"
 ],
 "priority": "high",
 "prerequisites": [
  "ca.quadgraph.vertex"
 ],
 "process_card": "Graphing a quadratic function with the MyMathLab graph tool",
 "var": "x",
 "params": {
  "a": {
   "choice": [
    1,
    -1,
    2,
    -2
   ]
  },
  "h": {
   "int": [
    -5,
    5
   ]
  },
  "k": {
   "int": [
    -6,
    6
   ]
  }
 },
 "let": {
  "fe": "expand(a (x - h)^2 + k)",
  "x2": "h + 1",
  "y2": "a + k",
  "hn": "-h",
  "x2n": "-h + 1"
 },
 "problem": {
  "task": "graph",
  "prompt": "Graph f(x) = {tex:fe}.",
  "function": "{fe}"
 },
 "steps": [
  {
   "name": "find the vertex",
   "result": "{k}",
   "show": "({h}, {k})",
   "check": "equal",
   "to": "{k}"
  },
  {
   "name": "choose the parabola tool",
   "result": "",
   "show": "parabola",
   "check": "text"
  },
  {
   "name": "click the vertex",
   "result": "",
   "show": "({h}, {k})",
   "check": "text"
  },
  {
   "name": "click one more point",
   "result": "{y2}",
   "show": "x = {x2}: f({x2}) = {y2}, click ({x2}, {y2})",
   "check": "equal",
   "to": "{y2}"
  }
 ],
 "answer": {
  "kind": "graph",
  "value": "parabola; ({h}, {k}); ({x2}, {y2})",
  "say": "Parabola with vertex ({h}, {k}) through ({x2}, {y2})."
 },
 "mistakes": [
  {
   "id": "wrong_side",
   "name": "vertex mirrored (sign of h)",
   "applies_if": "h != 0",
   "rule": {
    "answer_equals": "parabola; ({hn}, {k}); ({x2n}, {y2})"
   },
   "message": "The vertex x is -b/(2a); in a(x - h)^2 + k it is h, not -h."
  }
 ],
 "hints": [
  {
   "step": "find the vertex",
   "hint": "x = -b/(2a), then f of that.",
   "why": "MyMathLab's tool asks for the vertex first."
  },
  {
   "step": "choose the parabola tool",
   "hint": "x squared: a parabola.",
   "why": "Quadratic functions graph as parabolas."
  },
  {
   "step": "click the vertex",
   "hint": "Click (h, k) first.",
   "why": "The tool anchors the parabola at its vertex."
  },
  {
   "step": "click one more point",
   "hint": "Go one step right of the vertex and compute f there.",
   "why": "One more point fixes how wide the parabola is and which way it opens."
  }
 ]
}